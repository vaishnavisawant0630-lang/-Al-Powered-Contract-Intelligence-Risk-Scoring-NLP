# .env.example
# =============
# All environment variables used by the platform.
# Copy to .env and fill in values before running:
#   cp .env.example .env
#
# .env is gitignored — never commit secrets.
# This file IS committed — it documents all required config.

# ------------------------------------------------------------------
# Paths (relative to project root OR absolute)
# ------------------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models

# ------------------------------------------------------------------
# OCR Configuration
# ------------------------------------------------------------------
# Path to the tesseract binary. Leave empty to auto-detect via PATH.
TESSERACT_CMD=

# Render DPI for scanned PDFs. Higher = better quality, slower.
# Recommended range: 200–400. Default: 300.
OCR_DPI=300

# Tesseract language code. Use 'eng' for English contracts.
# For multilingual: 'eng+fra' etc.
OCR_LANG=eng

# Chars per page below which a PDF is treated as scanned (triggers OCR).
# Increase if digital PDFs are being incorrectly flagged as scanned.
OCR_CHAR_DENSITY_THRESHOLD=50

# ------------------------------------------------------------------
# spaCy / NER Training
# ------------------------------------------------------------------
# Base spaCy model for NER (must be installed: python -m spacy download ...)
SPACY_BASE_MODEL=en_core_web_lg

# Number of training epochs (default: 20)
NER_TRAIN_EPOCHS=20

# Training mini-batch size (default: 32)
NER_BATCH_SIZE=32

# GPU device ID. -1 = CPU only (Phase 1). 0 = first GPU.
GPU_ID=-1

# ------------------------------------------------------------------
# Data Processing
# ------------------------------------------------------------------
# Fraction of CUAD used for training (rest → dev). Default: 0.85
CUAD_TRAIN_SPLIT=0.85

# Random seed for reproducible train/dev splits
CUAD_RANDOM_SEED=42

# Maximum character length per NER sample chunk
MAX_TEXT_LENGTH=512

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Log format: json (production) | console (local development)
LOG_FORMAT=console