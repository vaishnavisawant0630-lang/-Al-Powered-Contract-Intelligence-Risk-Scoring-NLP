# .env.example
# =============
# All environment variables used by the platform.
# Copy to .env and fill in values before running:
#   cp .env.example .env
#
# .env is gitignored — never commit secrets.
# This file IS committed — it documents all required config.

# ------------------------------------------------------------------
# Paths (relative to project root OR absolute)
# ------------------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models

